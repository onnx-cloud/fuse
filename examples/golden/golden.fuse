@fuse 0.7
@opset onnx 18
@version 0.7.0
@domain examples.golden.clip
@meta author = "onnx.cloud"
@meta description = "Grammar-compliant ONNX-only CLIP-style dual encoder with correct token generation"

# -----------------
# constants
# -----------------

const VOCAB: i64 = 49152
const VOCAB_MAX: f32 = 49151.0

# -----------------
# types
# -----------------

type Img        = f32[B,3,224,224]
type Tokens     = i64[B,77]
type ImgFeat    = f32[B,768]
type TxtFeat    = f32[B,768]
type Similarity = f32[B,1]

# -----------------
# trainable weights
# -----------------

@train weight W_img_proj: f32[3,768]
@train weight b_img_proj: f32[768]

@train weight W_txt_embed: f32[VOCAB,768]
@train weight b_txt_embed: f32[768]

@train weight W_img_head: f32[768,768]
@train weight b_img_head: f32[768]

@train weight W_txt_head: f32[768,768]
@train weight b_txt_head: f32[768]

# -----------------
# image encoder
# -----------------

fn image_encoder(x: Img) -> ImgFeat {

  # global average pool H,W → [B,3]
  pooled = ReduceMean(x, axes=[2,3], keepdims=0)

  proj = MatMul(pooled, W_img_proj)
  proj = Add(proj, b_img_proj)

  head = MatMul(proj, W_img_head)
  head = Add(head, b_img_head)

  out = LpNormalization(head, p=2, axis=1)

  out
}

# -----------------
# text encoder
# -----------------

fn text_encoder(tokens: Tokens) -> TxtFeat {

  # embedding lookup -> [B,77,768]
  tok = Gather(W_txt_embed, tokens, axis=0)

  tok = Add(tok, b_txt_embed)

  # mean pool tokens -> [B,768]
  pooled = ReduceMean(tok, axes=[1], keepdims=0)

  head = MatMul(pooled, W_txt_head)
  head = Add(head, b_txt_head)

  out = LpNormalization(head, p=2, axis=1)

  out
}

# -----------------
# similarity
# -----------------

fn similarity(img: ImgFeat, txt: TxtFeat) -> Similarity {

  prod = Mul(img, txt)
  score = ReduceSum(prod, axes=[1], keepdims=1)

  score
}

# -----------------
# end-to-end CLIP score
# -----------------

fn clip_score(x_img: Img, x_txt: Tokens) -> Similarity {

  i_feat = image_encoder(x_img)
  t_feat = text_encoder(x_txt)

  out = similarity(i_feat, t_feat)

  out
}

# -----------------
# deterministic proof
# -----------------

@proof graph golden() {

  # image input
  x_img: Img = RandomUniform()

  # generate valid integer token ids
  tmp: f32[B,77] = RandomUniform()
  tmp = Mul(tmp, VOCAB_MAX)
  x_txt: Tokens = Cast(tmp, to=i64)

  out = clip_score(x_img, x_txt)

  assert Rank(out) == 2
}