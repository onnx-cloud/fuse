@fuse 0.7
@opset onnx 18
@version 0.7.0
@domain examples.golden.jepa
@meta attribution = "Inspired by I-JEPA (LeCun et al., Meta AI, 2023)"

# JEPA (Joint Embedding Predictive Architecture) 
# operators: encoder, predictor, target encoder, and training.

@id "https://ns.onnx.cloud/examples.golden.jepa"
# trainable and frozen weights/biases for encoder and predictor.

@train weight W_patch: f32[768, 3, 16, 16]
@train weight b_patch: f32[768]

@train weight W_p1: f32[768, 768]
@train weight b_p1: f32[768]
@train weight W_p2: f32[768, 768]
@train weight b_p2: f32[768]

@frozen weight W_t_patch: f32[768, 3, 16, 16]
@frozen weight b_t_patch: f32[768]

# Predictor: simple MLP that maps context latents to predictions.
@type "https://ns.onnx.cloud/examples.golden.jepa.predictor"

fn predictor(z_ctx: f32[1,196,768]) -> f32[1,196,768] {

  h1 = z_ctx @ W_p1
  h1b = h1 + b_p1
  h1a = Relu(h1b)

  h2 = h1a @ W_p2
  h2b = h2 + b_p2
  return h2b
}

# Patch Encoder: conv-based patch extraction that produces latent tokens.
@type "https://ns.onnx.cloud/examples.golden.jepa.patch.encode"

fn patch_encode(
  x: f32[1,3,224,224],
  W: f32[768,3,16,16],
  b: f32[768]
) -> f32[1,196,768] {

  p = Conv(
        x, W, b,
        stride@=16,
        pads@=[0,0,0,0]
      )

  z = Reshape(p, [1,196,768])
  return z
}


# Mask application: helper to apply boolean masks to token latents.

fn apply_mask(
  z: f32[1,196,768],
  mask: bool[1,196]
) -> f32[1,196,768] {

  m = Cast(mask, to@="f32")
  # Avoid passing 'axes' attribute which some ONNX schema lookups reject in
  # our environment; using Reshape to add the extra dimension is equivalent
  # here (mask shape [1,196] -> [1,196,1]).
  m3 = Reshape(m, [1,196,1])
  return z * m3
}

# Latent regression energy: masked MSE loss used for training.
@type "https://ns.onnx.cloud/examples.golden.jepa.latent.energy"

fn latent_mse(
  z_hat: f32[1,196,768],
  z_tgt: f32[1,196,768],
  mask: bool[1,196]
) -> f32 {

  diff = z_hat - z_tgt
  sq = diff * diff

  masked = apply_mask(sq, mask)
  sum = ReduceSum(masked)

  denom = ReduceSum(Cast(mask, to@="f32"))
  loss = sum / denom
  return loss
}

# Training: end-to-end and slice graphs for tests.
@id "https://my.onnx.cloud/examples.golden.jepa.training"
@type "https://ns.onnx.cloud/examples.golden.jepa.training"

@training {
  optimizer = Adam,
  lr = 1e-3
}
graph jepa_train(
  x_ctx: f32[1,3,224,224],
  x_tgt: f32[1,3,224,224],
  mask: bool[1,196]
) -> (f32[1,196,768], f32[1,196,768], f32) {

  z_ctx  = patch_encode(x_ctx, W_patch, b_patch)
  z_pred = predictor(z_ctx)
  z_tgt  = patch_encode(x_tgt, W_t_patch, b_t_patch)

  loss = latent_mse(z_pred, z_tgt, mask)
  return z_pred, z_tgt, loss
}

# Graph: Encoder-only
@id "https://my.onnx.cloud/examples.golden.jepa.encode"
@type "https://ns.onnx.cloud/examples.golden.jepa.encode"

graph jepa_encode(
  x: f32[1,3,224,224]
) -> f32[1,196,768] {

  return patch_encode(x, W_patch, b_patch)
}

# Graph: : Predictor-only
@id "https://my.onnx.cloud/examples.golden.jepa.predict"
@type "https://ns.onnx.cloud/examples.golden.jepa.predict"

graph jepa_predict(
  z_ctx: f32[1,196,768]
) -> f32[1,196,768] {

  return predictor(z_ctx)
}

# Graph: Target encoder
@id "https://my.onnx.cloud/examples.golden.jepa.target.encode"
@type "https://ns.onnx.cloud/examples.golden.jepa.target.encode"

graph jepa_target_encode(
  x: f32[1,3,224,224]
) -> f32[1,196,768] {
  return patch_encode(x, W_t_patch, b_t_patch)
}
