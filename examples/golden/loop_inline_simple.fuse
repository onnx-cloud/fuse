@fuse 0.7
@opset onnx 19
@domain examples.golden

# Simple inline loop example
graph simple_loop_test(max_iter: i64) -> f32 {
    # Loop body takes (iteration, condition, state)
    # and returns (next_iter, next_cond, next_state)
    result = loop (max_iter, true, 0.0) {
        # Body parameters available as:
        # - i: current iteration (i64)
        # - keep: loop condition (bool) 
        # - state_in: current state
        
        new_state = Add(state_in, 1.0)
        keep_val = Less(new_state, 10.0)
        next_i = Add(i, 1)
        
        return next_i, keep_val, new_state
    }
    
    return result
}
