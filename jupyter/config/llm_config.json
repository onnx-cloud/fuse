      "label": "@fuse architect"
    },
    "coder": {
      "model": "deepseek-coder",
      "url": "https://api.deepseek.com/chat/completions",
      "secretEnv": "DEEPSEEK_API_KEY",
      "prompt": "config/prompts/coder/deepseek.md",
      "label": "@fuse co-pilot"
    }
  }
}