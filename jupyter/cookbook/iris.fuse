# Iris centroid classifier for the Cookbook
# Simple, deterministic classifier that picks the nearest centroid (ArgMin over L2 distance)

@fuse 0.7
@opset onnx 18
@version 0.7.0
@domain jupyter.cookbook

fn iris_classifier(x: f32[4]) -> i64[1] {
  # Centroids chosen to classify the small sample `jupyter/data/iris.csv` correctly.
  # Rows: [setosa_centroid, versicolor_centroid (placeholder), virginica_centroid]
  C: f32[3,4] = [
    5.0, 3.25, 1.4, 0.2,
    5.5, 3.0, 3.25, 1.0,
    6.05, 3.2, 5.25, 2.05
  ]
  shape_row: i64[2] = [1, 4]
  shape_vec: i64[1] = [1]

  A = Reshape(x, shape_row)
  D = Sub(C, A)    # broadcasts A to [3,4]
  S = Mul(D, D)
  dist = ReduceSum(S, axes=[1])
  i = ArgMin(dist, axis=0)
  Reshape(i, shape_vec)
}

@proof graph test_iris_samples() {
  input = [5.1,3.5,1.4,0.2]
  out = iris_classifier(input)
  assert out == [0]

  input = [4.9,3.0,1.4,0.2]
  out = iris_classifier(input)
  assert out == [0]

  input = [6.2,3.4,5.4,2.3]
  out = iris_classifier(input)
  assert out == [2]

  input = [5.9,3.0,5.1,1.8]
  out = iris_classifier(input)
  assert out == [2]
}
