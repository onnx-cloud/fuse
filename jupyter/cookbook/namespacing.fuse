# Cookbook: Namespacing note (how exporter can apply stable prefixes)
# Ops: Add (simple identity-style demo)

@fuse 0.7
@opset onnx 18
@version 0.7.0
@domain jupyter.cookbook

fn demo_ns(x: f32[3]) -> f32[3] {
  Add(x, x)
}

@proof graph test_ns() {
  out = demo_ns([1.0, 1.0, 1.0])
  assert out == [2.0, 2.0, 2.0]
}