# Cookbook: Namespacing note (how exporter can apply stable prefixes)
# Ops: Add (simple identity-style demo)

@fuse 0.7
@opset onnx 18
@version 0.7.0
@domain jupyter.cookbook

# Notes on namespacing: the exporter can optionally apply stable prefixes like `file:function`.
# This example is a simple function demonstrating that behaviour is controlled by the CLI flags
# `--domain-by` and `--no-ns` rather than the source files themselves.

fn demo_ns(x: f32[3]) -> f32[3] {
  Add(x, x)
}

@proof graph test_ns() {
  out = demo_ns([1.0, 1.0, 1.0])
  assert out == [2.0, 2.0, 2.0]
}