{
  "scopeName": "source.fuse",
  "name": "Fuse",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.fuse", "match": "//.*$" },
        { "name": "comment.block.fuse", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.fuse", "begin": "\"", "end": "\"", "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fuse" } }, "endCaptures": { "0": { "name": "punctuation.definition.string.end.fuse" } } }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.fuse", "match": "\\b[0-9]+(\\.[0-9]+)?(e[+-]?[0-9]+)?\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.fuse", "match": "\\b(fuse|opset|module|domain|import|extern|block|node|model|graph|param|weight|const|pub|static|if|else|assert)\\b" },
        { "name": "storage.type.fuse", "match": "\\b(Tensor|f32|f64|i32|i64|bool)\\b" },
        { "name": "entity.name.section.fuse", "match": "@\\w+" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.fuse", "match": "->|:|,|=|\\(|\\)|\\{|\\}|\\[|\\]|@" }
      ]
    }
  }
}
